<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<fx:root fx:id="vueJoueurCourant" alignment="CENTER" prefHeight="150.0" prefWidth="1920.0" stylesheets="@../css/style.css" type="GridPane" xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1">
  <columnConstraints>
    <ColumnConstraints halignment="CENTER" hgrow="NEVER" />
    <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" />
      <ColumnConstraints halignment="CENTER" hgrow="NEVER" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="SOMETIMES" />
  </rowConstraints>
   <children>
      <VBox fx:id="playerDestinations" alignment="TOP_CENTER" spacing="10.0">
         <children>
            <Label fx:id="labelDestination" text="Destinations" />
            <VBox fx:id="vboxDestinations" alignment="CENTER" spacing="2.0" />
         </children>
         <padding>
            <Insets top="10.0" />
         </padding></VBox>
      <HBox fx:id="playerHBox" alignment="CENTER" GridPane.columnIndex="1">
         <children>
            <ImageView fx:id="piocheWagon" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fx:id="piocheBateau" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
         </children></HBox>
      <HBox fx:id="playerInfoBlock" GridPane.columnIndex="2">
         <children>
            <VBox fx:id="playerActions" alignment="CENTER" spacing="2.0">
               <children>
                  <GridPane id="block" fx:id="pionsGrid">
                    <columnConstraints>
                      <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" />
                      <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" />
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints vgrow="SOMETIMES" />
                      <RowConstraints vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/bouton-pions-wagon.png" />
                           </image>
                        </ImageView>
                        <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="1">
                           <image>
                              <Image url="@../images/bouton-pions-bateau.png" />
                           </image>
                        </ImageView>
                        <ImageView fitHeight="25.0" fitWidth="25.0" layoutX="33.0" layoutY="10.0" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="2">
                           <image>
                              <Image url="@../images/port.png" />
                           </image>
                        </ImageView>
                        <Label fx:id="pionsWagon" text="Label" GridPane.rowIndex="1">
                           <font>
                              <Font size="12.0" />
                           </font>
                           <padding>
                              <Insets top="5.0" />
                           </padding></Label>
                        <Label fx:id="pionsBateau" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <font>
                              <Font size="12.0" />
                           </font>
                           <padding>
                              <Insets top="5.0" />
                           </padding></Label>
                        <Label fx:id="pionsPort" layoutX="108.0" layoutY="47.0" text="Label" GridPane.columnIndex="2" GridPane.rowIndex="1">
                           <font>
                              <Font size="12.0" />
                           </font>
                           <padding>
                              <Insets top="5.0" />
                           </padding></Label>
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </GridPane>
                  <HBox id="block" spacing="5.0">
                     <children>
                        <TextField fx:id="commandField" />
                        <Button id="button-square" fx:id="btnSendCommand" mnemonicParsing="false">
                           <graphic>
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/icons/arrow-right.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </HBox>
                  <GridPane>
                     <columnConstraints>
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" />
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" />
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints valignment="CENTER" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <Button id="button-square" fx:id="btnDestination" mnemonicParsing="false">
                           <graphic>
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/icons/map.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <Button id="button-square" fx:id="btnChangerPions" mnemonicParsing="false" GridPane.columnIndex="1">
                           <graphic>
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/icons/arrow-swap.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <Button id="button-square" fx:id="btnPasserTour" mnemonicParsing="false" GridPane.columnIndex="2">
                           <graphic>
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/icons/passer.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </GridPane>
               </children>
            </VBox>
            <VBox fx:id="infoVBox" alignment="TOP_CENTER" layoutX="10.0" layoutY="10.0" spacing="25.0">
               <children>
                  <Label fx:id="playerName" text="Label" />
                  <VBox fx:id="colorBack" alignment="BOTTOM_CENTER" maxHeight="70.0" maxWidth="70.0" minHeight="70.0" minWidth="70.0">
                     <children>
                        <ImageView fx:id="playerAvatar" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" translateY="4.0">
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                        </ImageView>
                     </children>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </VBox>
               </children>
               <padding>
                  <Insets top="15.0" />
               </padding></VBox>
         </children>
      </HBox>
   </children>
</fx:root>
