<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<fx:root alignment="CENTER" prefHeight="982.0" prefWidth="1512.0" stylesheets="@../css/style.css" type="GridPane" xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1">
    <columnConstraints>
        <ColumnConstraints hgrow="NEVER" />
        <ColumnConstraints hgrow="ALWAYS" />
        <ColumnConstraints hgrow="NEVER" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
    </rowConstraints>
    <children>
        <HBox fx:id="topHBox" alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.columnSpan="2">
            <children>
                <VBox fx:id="console" alignment="TOP_CENTER" spacing="10.0">
                    <children>
                        <Label text="Console" />
                        <ScrollPane fx:id="consoleScrollPane" vbarPolicy="ALWAYS">
                            <content>
                                <VBox fx:id="consoleHistory" prefHeight="111.0" prefWidth="279.0" spacing="10.0">
                                    <padding>
                                        <Insets top="25.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                    <padding>
                        <Insets top="10.0" />
                    </padding>
                </VBox>
            </children>
        </HBox>
        <VBox fx:id="infoVBox_2" />
        <HBox fx:id="bottomHBox" alignment="CENTER" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="2" />

        <VBox fx:id="rightVBox" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <GridPane fx:id="leftVBox" alignment="CENTER" GridPane.rowIndex="1">
            <VBox fx:id="destinationVBox" alignment="CENTER" GridPane.rowIndex="1">
                <children>
                    <ImageView fx:id="destinationCard" fitHeight="100.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
                </children>
            </VBox>
            <VBox fx:id="piocheVBox" alignment="CENTER" GridPane.rowIndex="3">
                <children>
                    <ImageView fx:id="pileCard" fitHeight="100.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
                </children>
            </VBox>
            <columnConstraints>
                <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
            <!--            <VBox fx:id="deckVBox" alignment="CENTER" GridPane.rowIndex="2"/>-->
        </GridPane>
        <VBox fx:id="centerBox" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    </children>
</fx:root>
