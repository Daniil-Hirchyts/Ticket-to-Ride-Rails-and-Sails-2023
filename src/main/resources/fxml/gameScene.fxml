<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<fx:root alignment="CENTER" prefHeight="1069.0" prefWidth="1920.0" stylesheets="@../css/style.css" type="GridPane" xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1">
    <columnConstraints>
        <ColumnConstraints hgrow="NEVER" />
        <ColumnConstraints hgrow="ALWAYS" />
        <ColumnConstraints hgrow="NEVER" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints vgrow="NEVER" />
        <RowConstraints vgrow="ALWAYS" />
        <RowConstraints vgrow="NEVER" />
    </rowConstraints>
    <children>
        <HBox fx:id="topHBox" alignment="CENTER" GridPane.columnIndex="1" />
        <VBox fx:id="infoVBox_2" />
        <VBox fx:id="infoVBox_3" GridPane.columnIndex="2" />
        <VBox fx:id="rightVBox" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <VBox fx:id="infoVBox" alignment="CENTER" prefHeight="150.0" GridPane.rowIndex="2">
            <children>
                <Label fx:id="handLabel" />
            </children>
        </VBox>
        <VBox fx:id="playerVBox" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <HBox fx:id="bottomHBox" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <children>
                <HBox fx:id="playerHBox" alignment="CENTER" />
            </children>
        </HBox>
        <GridPane fx:id="leftVBox" GridPane.rowIndex="1">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS" />
                <RowConstraints vgrow="SOMETIMES" />
                <RowConstraints vgrow="ALWAYS" />
            </rowConstraints>
            <children>
                <VBox fx:id="destinationVBox" alignment="CENTER">
                    <children>
                        <ImageView fx:id="destinationCard" fitHeight="100.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
                    </children>
                </VBox>
                <VBox fx:id="piocheVBox" alignment="CENTER" GridPane.rowIndex="2">
                    <children>
                        <ImageView fx:id="pileCard" fitHeight="100.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
                    </children>
                </VBox>
                <VBox fx:id="deckVBox" alignment="CENTER" GridPane.rowIndex="1" />
            </children>
        </GridPane>
      <VBox fx:id="centerBox" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    </children>
</fx:root>
