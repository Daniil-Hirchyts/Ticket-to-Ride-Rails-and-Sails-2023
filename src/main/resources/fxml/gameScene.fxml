<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<fx:root alignment="CENTER" prefHeight="800.0" prefWidth="1080.0" stylesheets="@../css/style.css" type="GridPane" xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1">
    <columnConstraints>
        <ColumnConstraints hgrow="NEVER" />
        <ColumnConstraints hgrow="ALWAYS" />
        <ColumnConstraints hgrow="NEVER" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
    </rowConstraints>
    <children>
        <HBox fx:id="topHBox" alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.columnSpan="2">
            <children>
                <VBox fx:id="console" alignment="TOP_CENTER" spacing="10.0">
                    <children>
                        <Label text="Console" />
                        <ScrollPane fx:id="consoleScrollPane" vbarPolicy="ALWAYS">
                            <content>
                                <VBox fx:id="consoleHistory" prefHeight="111.0" prefWidth="279.0" spacing="10.0">
                                    <padding>
                                        <Insets top="25.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                    <padding>
                        <Insets top="10.0" />
                    </padding>
                </VBox>
            </children>
        </HBox>
        <VBox fx:id="infoVBox_2" />

        <VBox fx:id="rightVBox" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1" />
      <GridPane fx:id="leftVBox" GridPane.rowIndex="1">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints vgrow="ALWAYS" />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
         <children>
            <VBox fx:id="piocheBox" alignment="CENTER" prefHeight="500.0" />
            <VBox id="pile" fx:id="pileBateau" alignment="CENTER" maxHeight="100.0" maxWidth="150.0" minHeight="100.0" minWidth="150.0" GridPane.rowIndex="1">
               <children>
                  <ImageView fitWidth="80.0" pickOnBounds="true" preserveRatio="true" rotate="270.0">
                     <image>
                        <Image url="@../images/cartesWagons/dos-BATEAU.png" />
                     </image></ImageView>
               </children>
            </VBox>
            <VBox id="pile" fx:id="pileWagon" alignment="CENTER" GridPane.rowIndex="2">
               <children>
                  <ImageView fitWidth="80.0" pickOnBounds="true" preserveRatio="true" rotate="270.0">
                     <image>
                        <Image url="@../images/cartesWagons/dos-WAGON.png" />
                     </image></ImageView>
               </children>
            </VBox>
         </children>
      </GridPane>
    </children>
</fx:root>
